  </Grid></DataTemplate>
  <DataTemplate x:Key="FolderTemplate"><Grid Width="208" Height="82"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="32" Height="30" VerticalAlignment="Top"><Path x:Name="FileGlyph" Data="M1,5 L10,5 13,8 29,8 29,25 1,25 Z M1,11 L29,11" Fill="#C5DEFF" Stroke="#4A8CDF" StrokeThickness="1.3" StrokeLineJoin="Round"/></Viewbox><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="40" ToolTip="{Binding Name}"/><TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="#626873" Margin="0,5,0,0"/></StackPanel></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="False"><Setter TargetName="FileGlyph" Property="Data" Value="M5,1 L19,1 27,9 27,29 5,29 Z M19,1 L19,9 27,9 M10,15 L22,15 M10,20 L22,20"/><Setter TargetName="FileGlyph" Property="Fill" Value="#F1F4FA"/><Setter TargetName="FileGlyph" Property="Stroke" Value="#7C8DA8"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F2F6" BorderBrush="#E2E5EB" BorderThickness="0,0,1,0"><Grid Margin="16,28,16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="12,0,0,36"><Border Width="44" Height="44" HorizontalAlignment="Left" Background="#0069DE" CornerRadius="13"><Viewbox Margin="11"><Path Data="M12,1 L12,8 M8,8 L16,8 16,12 8,12 Z M12,12 L12,16 M2,22 L2,16 22,16 22,22 M12,16 L12,22" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"/></Viewbox></Border><TextBlock Text="Rede Clara" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Perto. Conectado. Simples." FontSize="11" Foreground="#697180"/></StackPanel>
   <StackPanel Grid.Row="1"><Button x:Name="NavNetwork" Style="{StaticResource Nav}" Content="Minha rede"/><Button x:Name="NavSetup" Style="{StaticResource Nav}" Content="Preparação automática"/><Button x:Name="NavShare" Style="{StaticResource Nav}" Content="Compartilhar pasta"/><Button x:Name="NavHelp" Style="{StaticResource Nav}" Content="Ajuda e diagnóstico"/></StackPanel>
   <StackPanel Grid.Row="3" Margin="10,0"><CheckBox x:Name="ReducedMotion" Content="Reduzir movimento" FontSize="12" Foreground="#626873" Margin="0,0,0,16"/><TextBlock x:Name="AdminBadge" Text="Verificando administrador…" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Text="Windows · v0.1.0" FontSize="11" Foreground="#697180" Margin="0,5,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,28,30,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="NetworkPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="Sua rede, mais perto." Style="{StaticResource Title}"/><TextBlock Text="Computadores e pastas da sua rede, em um só lugar." Style="{StaticResource Caption}"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AdapterBox" MinHeight="42" VerticalContentAlignment="Center" Padding="10,5" AutomationProperties.Name="Conexão de rede"/><Button x:Name="ReloadAdapters" Grid.Column="1" Content="Atualizar rede" Margin="8,0,0,0"/><Button x:Name="ScanButton" Grid.Column="2" Content="Buscar computadores" Style="{StaticResource Primary}" Margin="8,0,0,0"/></Grid>
    <Border Grid.Row="2" Background="#EDF3FD" CornerRadius="12" Padding="15,12" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NetworkStatus" Text="Preparando sua conexão…" FontWeight="SemiBold" Foreground="#2D507E"/><TextBlock x:Name="RangeText" Text="A descoberta funciona na rede local selecionada." FontSize="12" Foreground="#526A8B" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center"><Ellipse x:Name="ScanPulse" Width="10" Height="10" Fill="#0069DE"/></Border></Grid></Border>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="4,2,4,14"><TextBlock Text="Computadores e dispositivos" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="DeviceCount" Text="0" Foreground="#697180" HorizontalAlignment="Right"/></DockPanel>
     <Grid Grid.Row="1" Margin="2,0,2,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Buscar na lista" VerticalAlignment="Center" Foreground="#626873" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="FilterBox" ToolTip="Filtrar por nome ou IP" AutomationProperties.Name="Filtrar dispositivos"/></Grid>
     <ListBox x:Name="DeviceList" Grid.Row="2" ItemTemplate="{StaticResource DeviceTemplate}" AutomationProperties.Name="Dispositivos descobertos"/>
     <Border Grid.Row="3" BorderBrush="#E5E7ED" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="2,12,2,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Não apareceu na busca?" FontWeight="SemiBold"/><TextBlock Text="Entre pelo nome ou IP do computador." FontSize="12" Foreground="#697180" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="ManualHost" Grid.Column="1" ToolTip="Ex.: PC-SALA ou 192.168.1.10" AutomationProperties.Name="Nome ou IP do computador"/><Button x:Name="AddHostButton" Grid.Column="2" Content="Conectar" Padding="15,8" Margin="8,0,0,0"/></Grid></Border>
    </Grid></Border>
   </Grid>
   <Grid x:Name="DevicePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><Button x:Name="BackToComputers" Content="Voltar aos computadores" HorizontalAlignment="Left" Padding="12,7" MinHeight="34" Margin="0,0,0,16"/><TextBlock x:Name="SelectedHost" Text="Computador" Style="{StaticResource Title}"/><TextBlock x:Name="SelectedAddress" Text="Pastas disponíveis na rede local." Style="{StaticResource Caption}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="UpFolderButton" Content="Voltar uma pasta" Margin="0,0,8,0" IsEnabled="False"/><TextBox Grid.Column="1" x:Name="DeviceFilterBox" AutomationProperties.Name="Filtrar pastas e arquivos" ToolTip="Buscar nesta pasta"/><Button x:Name="RefreshShares" Grid.Column="2" Content="Atualizar" Margin="8,0,0,0"/></Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22"><Grid x:Name="ShareDetail"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BrowseLocation" Text="Pastas compartilhadas" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="FolderCount" Text="Dê dois cliques em uma pasta para navegar." Foreground="#697180" FontSize="12" Margin="0,5,0,0"/></StackPanel><CheckBox x:Name="ShowHidden" Grid.Column="1" Content="Pastas administrativas" FontSize="12" VerticalAlignment="Center" ToolTip="Mostra C$, ADMIN$ e outros compartilhamentos ocultos. Exigem permissão administrativa no destino."/></Grid>
     <Grid Grid.Row="1"><ListBox x:Name="ShareList" ItemTemplate="{StaticResource ShareTemplate}" AutomationProperties.Name="Pastas e arquivos do computador" ScrollViewer.CanContentScroll="False"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><ScrollViewer x:Name="ShareEmptyHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ShareEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,16"><Viewbox Width="68" Height="58" Margin="0,0,0,20"><Path Data="M1,5 L10,5 13,8 29,8 29,25 1,25 Z" Fill="#E2EDFF" Stroke="#A8C6F0" StrokeThickness="0.7"/></Viewbox><TextBlock x:Name="ShareMessage" Text="Consultando as pastas do computador…" Foreground="#626873" TextAlignment="Center"/><Button x:Name="ConnectButton" Content="Entrar com uma conta do Windows" Margin="0,18,0,0" Visibility="Collapsed"/></StackPanel></ScrollViewer></Grid>
     <Border Grid.Row="2" Margin="0,18,0,0" Padding="0,16,0,0" BorderBrush="#E5E7ED" BorderThickness="0,1,0,0"><StackPanel><TextBlock x:Name="SharePath" Foreground="#697180" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,12"/><WrapPanel><Button x:Name="EnterFolderButton" Content="Explorar pasta" Style="{StaticResource Primary}" Margin="0,0,8,4" IsEnabled="False"/><Button x:Name="OpenShare" Content="Abrir no Windows" Margin="0,0,8,4" IsEnabled="False"/><Button x:Name="CopyPath" Content="Copiar caminho" Margin="0,0,8,4" IsEnabled="False"/><Button x:Name="MapDrive" Content="Mapear unidade…" Margin="0,0,0,4" IsEnabled="False"/></WrapPanel></StackPanel></Border>
    </Grid></Border>
   </Grid>
   <Grid x:Name="SetupPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="O Windows, preparado." Style="{StaticResource Title}"/><TextBlock Text="Ajustes automáticos para este computador encontrar e ser encontrado." Style="{StaticResource Caption}"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="SetupHeadline" Text="Verificando a rede selecionada…" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SetupSummary" Text="Na primeira abertura, preparamos automaticamente as redes privadas." Foreground="#626873" Margin="0,10,0,22"/>
      <TextBlock Text="01   Descoberta e publicação do computador" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Text="02   Compartilhamento de arquivos do Windows" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Text="03   Firewall limitado à rede local privada" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <WrapPanel><Button x:Name="PrepareButton" Content="Preparar novamente" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="TrustButton" Content="Confiar nesta rede e preparar" Margin="0,0,8,8"/><Button x:Name="DiagnoseButton" Content="Conferir estado" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="Use “Confiar” somente na sua rede de casa ou trabalho. A preparação precisa ser executada nos computadores que vão compartilhar arquivos." FontSize="12" Foreground="#697180" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Acesso com sua conta do Windows" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="A preparação mantém as senhas e as permissões das pastas. Acesso de administrador neste PC não concede acesso automático aos outros." Foreground="#626873" Margin="0,8,0,12"/><Expander Header="Ver detalhes da configuração"><TextBox x:Name="SetupDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="260" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12"/></Expander><Button x:Name="UndoButton" Content="Desfazer preparação deste app" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid x:Name="CreateSharePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Uma pasta. Ao seu alcance." Style="{StaticResource Title}"/><TextBlock Text="Escolha o que compartilhar. O app configura o acesso no Windows." Style="{StaticResource Caption}"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pasta neste computador" FontWeight="SemiBold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPath" IsReadOnly="True" AutomationProperties.Name="Pasta a compartilhar"/><Button x:Name="BrowseFolder" Grid.Column="1" Content="Escolher…" Margin="8,0,0,0"/></Grid><TextBlock Text="Nome na rede" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBox x:Name="ShareName" AutomationProperties.Name="Nome do compartilhamento" MaxLength="80"/>
      <TextBlock Text="Permissão de acesso" FontWeight="SemiBold" Margin="0,20,0,12"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ReadOnlyRadio" GroupName="Access" Content="Somente leitura" IsChecked="True" Margin="0,0,24,0"/><RadioButton x:Name="WritableRadio" GroupName="Access" Content="Ler e gravar"/></StackPanel>
      <Border Background="#F3F6FB" CornerRadius="10" Padding="15" Margin="0,24,0,18"><StackPanel><TextBlock Text="Quem pode entrar" FontWeight="SemiBold"/><TextBlock x:Name="AccountText" Foreground="#2D507E" Margin="0,6,0,6"/><TextBlock Text="No outro PC, entre com esta conta e a senha do Windows. O PIN usado para desbloquear o computador não é a senha da conta." FontSize="12" Foreground="#626873"/></StackPanel></Border>
      <Button x:Name="CreateShareButton" Content="Compartilhar esta pasta" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock x:Name="CreateShareMessage" Text="O acesso é criado apenas para a conta indicada acima." Foreground="#626873" Margin="0,14,0,0"/>
     </StackPanel></Border>
     <TextBlock Text="Pastas do sistema e discos inteiros são protegidos. Compartilhamentos existentes são preservados." Style="{StaticResource Caption}" Margin="4,16,0,0"/>
    </StackPanel></ScrollViewer>
   </Grid>
